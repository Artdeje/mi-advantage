{
  "name": "mi-advantage",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run api\" \"npm run email\" \"vite --port=3000 --host=0.0.0.0\"",
    "build": "vite build && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "preview": "vite preview",
    "start": "node -e \"if(!require('fs').existsSync('dist/server.js')){require('child_process').execSync('npm run build',{stdio:'inherit'})}\" && node dist/server.js",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
    "lint": "tsc --noEmit",
    "db:init": "tsx scripts/db-init.ts",
    "db:seed-supabase": "tsx scripts/seed-mysql-to-supabase.ts",
    "email": "tsx server/email-server.ts",
    "api": "tsx server/api-server.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.5",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.23.3",
    "nodemailer": "^9.0.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react-router-dom": "^5.3.3",
    "concurrently": "^10.0.5",
    "tsx": "^4.21.0"
  }
}
