# Local MySQL Database (XAMPP)
# VITE_API_URL: base URL for the API server. Leave empty ("") for Vite dev proxy.
VITE_API_URL=""
# VITE_EMAIL_API_URL: base URL for the email server. Leave empty ("") for Vite dev proxy.
VITE_EMAIL_API_URL=""
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="mi_advantage"
API_SERVER_PORT="3002"
EMAIL_SERVER_PORT="3001"

# Gmail SMTP Authentication Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
