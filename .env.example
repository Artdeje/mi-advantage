# Supabase Database (server-side, service_role — NEVER expose in VITE_* / browser)
# 1. Create a project at https://supabase.com/dashboard
# 2. Run supabase-schema.sql once in the Supabase Dashboard → SQL Editor
# 3. Copy Project URL + service_role key (Project Settings → API) below.
#    (Use the "secret" service_role key — NOT the anon/public key.)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# VITE_API_URL: base URL for the API server. Leave empty ("") for Vite dev proxy
# and single-service production (same-origin /api/...).
VITE_API_URL=""
# VITE_EMAIL_API_URL: base URL for the email server. Leave empty ("") — the API
# server also handles /api/send-email in production.
VITE_EMAIL_API_URL=""
API_SERVER_PORT="3002"
EMAIL_SERVER_PORT="3001"

# One-off MySQL → Supabase migration (scripts/seed-mysql-to-supabase.ts).
# Only needed if you have existing data in local MySQL (XAMPP) to carry over.
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="mi_advantage"

# Gmail SMTP Authentication Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
